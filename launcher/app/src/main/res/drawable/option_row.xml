<?xml version="1.0" encoding="utf-8"?>
<!--
    A row or a button. The focused one gets a soft fill and a thin white
    ring, the same as the focus ring on a card. A solid white block was too
    harsh and it did not match the rest of the screen.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2EFFFFFF" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1.5dp"
                android:color="#E6FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
