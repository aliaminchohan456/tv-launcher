<?xml version="1.0" encoding="utf-8"?>
<!--
    The card behind the long press menu. A soft dark glass with a faint white
    line, the same language as the dock.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#E00E0E11"
        android:startColor="#F01C1A1F"
        android:type="linear" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#26FFFFFF" />
</shape>
