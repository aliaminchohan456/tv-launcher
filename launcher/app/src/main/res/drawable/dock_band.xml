<?xml version="1.0" encoding="utf-8"?>
<!--
    The dock container. A translucent dark fill lets the ambient wash show
    through, the faint white line catches the light. The corner radius is the
    card radius plus the dock padding, so the two curves are concentric:
    16dp card + 18dp padding = 34dp container. The padding also has to hold
    the focused card, which grows and takes its focus ring with it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#BD0B0D12"
        android:startColor="#C1242028"
        android:type="linear" />
    <corners android:radius="34dp" />
    <stroke
        android:width="1dp"
        android:color="#26FFFFFF" />
</shape>
