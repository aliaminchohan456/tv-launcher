<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:focusable="true">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Full-screen colour of the focused dock app. Fades to black before the edges. -->
    <com.cleanhome.tv.AmbientBackgroundView
        android:id="@+id/glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="26dp"
        android:paddingEnd="56dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:id="@+id/home_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.22"
                    android:textAllCaps="true"
                    android:textColor="#8CFFFFFF"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.04"
                        android:textColor="#FFFFFF"
                        android:textSize="52sp" />

                    <TextView
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="8dp"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true"
                        android:textColor="#B3FFFFFF"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="8dp"
                        android:background="#33FFFFFF" />

                    <TextView
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="9dp"
                        android:letterSpacing="0.14"
                        android:textAllCaps="true"
                        android:textColor="#A6FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/pill_inputs"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/pill_bg"
                android:drawableStart="@drawable/ic_input"
                android:drawablePadding="9dp"
                android:drawableTint="@drawable/pill_text"
                android:gravity="center"
                android:letterSpacing="0.01"
                android:paddingStart="16dp"
                android:paddingEnd="18dp"
                android:text="Inputs"
                android:textColor="@drawable/pill_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/pill_wifi"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/pill_bg"
                android:drawableStart="@drawable/ic_wifi"
                android:drawablePadding="9dp"
                android:drawableTint="@drawable/pill_text"
                android:gravity="center"
                android:letterSpacing="0.01"
                android:paddingStart="16dp"
                android:paddingEnd="18dp"
                android:text="Wi-Fi"
                android:textColor="@drawable/pill_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/pill_settings"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/pill_bg"
                android:drawableStart="@drawable/ic_settings"
                android:drawablePadding="9dp"
                android:drawableTint="@drawable/pill_text"
                android:gravity="center"
                android:letterSpacing="0.01"
                android:paddingStart="16dp"
                android:paddingEnd="18dp"
                android:text="Settings"
                android:textColor="@drawable/pill_text"
                android:textSize="15sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/stage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/shelf_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="40dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_marginBottom="10dp"
                android:includeFontPadding="false"
                android:letterSpacing="-0.015"
                android:textColor="#FFFFFF"
                android:textSize="48sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="784dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="blocksDescendants"
                android:focusable="false"
                android:overScrollMode="never"
                android:paddingTop="50dp"
                android:paddingBottom="0dp"
                android:visibility="gone" />
        </FrameLayout>

        <HorizontalScrollView
            android:id="@+id/dock_band"
            android:layout_width="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:descendantFocusability="blocksDescendants"
            android:focusable="false"
            android:fillViewport="true"
            android:scrollbars="none"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/dock_band"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:id="@+id/dock_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:gravity="start|center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <ImageView
        android:id="@+id/hint_down"
        android:layout_width="28dp"
        android:layout_height="14dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="6dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_down"
        android:visibility="gone" />

    <TextView
        android:id="@+id/dock_move_hint"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center"
        android:text="&#8592; / &#8594; Move     &#183;     OK Save     &#183;     Back Cancel"
        android:textColor="#E6FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/input_menu"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:background="@drawable/input_card"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone" />
</FrameLayout>
