<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/edit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="32dp"
        android:paddingEnd="56dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/edit_kicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.22"
                    android:text="HOME SCREEN"
                    android:textAllCaps="true"
                    android:textColor="#8CFFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/edit_heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Edit"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/edit_reset"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@drawable/option_row"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Reset to original"
                android:textColor="@drawable/option_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/edit_save"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/option_row"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="Save"
                android:textColor="@drawable/option_text"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.cleanhome.tv.CardArtView
                android:id="@+id/edit_preview"
                android:layout_width="200dp"
                android:layout_height="112dp"
                android:background="#FF141416"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/edit_name_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.18"
                    android:text="NAME"
                    android:textAllCaps="true"
                    android:textColor="#8CFFFFFF"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/edit_name"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edit_field"
                    android:hint="Name on the home screen"
                    android:imeOptions="actionDone"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#66FFFFFF"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/edit_name_help"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="This name is only shown on your home screen."
                    android:textColor="#73FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/edit_own_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:letterSpacing="0.16"
            android:text="ICONS FROM THIS APP"
            android:textAllCaps="true"
            android:textColor="#8CFFFFFF"
            android:textSize="12sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/own_icons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/edit_other_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:letterSpacing="0.16"
            android:text="OTHER ICONS"
            android:textAllCaps="true"
            android:textColor="#8CFFFFFF"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/edit_other_apps"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:background="@drawable/option_row"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="Icons from other app"
                android:textColor="@drawable/option_text"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/edit_from_gallery"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/option_row"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="Icon from gallery"
                android:textColor="@drawable/option_text"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
