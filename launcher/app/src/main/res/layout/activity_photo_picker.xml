<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/photo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="32dp"
        android:paddingEnd="56dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/photo_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.22"
            android:text="HOME SCREEN"
            android:textAllCaps="true"
            android:textColor="#8CFFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/photo_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Choose a picture"
            android:textColor="#FFFFFF"
            android:textSize="36sp" />

        <TextView
            android:id="@+id/photo_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="There are no pictures on this TV yet."
            android:textColor="#73FFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/photo_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="false"
            android:overScrollMode="never" />
    </LinearLayout>
</FrameLayout>
